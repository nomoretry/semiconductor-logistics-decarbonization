es and rates are illustrative; distances and emissions factors use public sources.", "error": null, "steps": 5, "tool_calls": [{"name": "describe_network", "arguments": {"network": "marvell"}, "ok": true, "seconds": 0.002, "result": {"network": "marvell", "label": "Marvell-inspired finished goods, Taiwan and Malaysia to Singapore", "weeks": 16, "skus": 12, "seed": 7, "demand_units": 4229, "demand_kg": 8211.2, "value_density_usd_per_kg": [6000, 18800], "lanes": [{"id": "TW_air", "mode": "air", "origin": "TW", "lead_weeks": 1, "distance_km": 3222, "freight_usd_per_kg": 5.5, "weekly_capacity_kg": 261.9, "reservable_kg": 130.9, "fixed_usd_per_week": 100.0, "kgco2e_per_kg": 2.148}, {"id": "TW_ocean", "mode": "ocean", "origin": "TW", "lead_weeks": 3, "distance_km": 4000, "freight_usd_per_kg": 0.6, "weekly_capacity_kg": 491.0, "reservable_kg": 0.0, "fixed_usd_per_week": 250.0, "kgco2e_per_kg": 0.079}, {"id": "MY_air", "mode": "air", "origin": "MY", "lead_weeks": 1, "distance_km": 297, "freight_usd_per_kg": 5.5, "weekly_capacity_kg": 147.5, "reservable_kg": 73.7, "fixed_usd_per_week": 100.0, "kgco2e_per_kg": 0.198}, {"id": "MY_road", "mode": "road", "origin": "MY", "lead_weeks": 1, "distance_km": 400, "freight_usd_per_kg": 0.7, "weekly_capacity_kg": 276.6, "reservable_kg": 0.0, "fixed_usd_per_week": 80.0, "kgco2e_per_kg": 0.051}], "scenarios": {"normal": {"probability": 0.65, "description": "No disruption."}, "typhoon": {"probability": 0.2, "description": "Typhoon closes Taiwan ports in weeks 5-6 (ocean capacity 0) and halves Taiwan air spot capacity at x1.5 spot price. Illustrative."}, "border_congestion": {"probability": 0.15, "description": "Malaysia-Singapore border congestion in weeks 8-10: road lead time +1 week and road capacity -40%. Illustrative."}, "demand_surge": {"probability": 0.0, "description": "Customer ramp-up: committed demand +30% in weeks 8-16. Illustrative."}}, "data_note": "Synthetic SKUs, demand, capacities and disruption factors; sourced distances an