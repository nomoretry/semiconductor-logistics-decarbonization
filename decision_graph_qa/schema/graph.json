  "required": [
    "id",
    "split",
    "profile",
    "seed",
    "policy",
    "observation",
    "state_text",
    "nodes",
    "edges",
    "modes",
    "objective",
    "ties",
    "hindsight"
  ],
  "additionalProperties": false
}
