          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P2.first.0",
                    "P2.first.1",
                    "P2.first.2"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stage": {
                  "const": "P2"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P2.peak.0",
                    "P2.peak.1",
                    "P2.peak.2"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "number"
                },
                "stage": {
                  "const": "P2"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P2.capacity"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "boolean"
                },
                "stage": {
                  "const": "P2"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P2.carbon"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "boolean"
                },
                "stage": {
                  "const": "P2"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P3.ship.0",
                    "P3.ship.1",
                    "P3.ship.2"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "boolean"
                },
                "stage": {
                  "const": "P3"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P3.load.0",
                    "P3.load.1"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "integer",
                  "minimum": 0
                },
                "stage": {
                  "const": "P3"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P3.emission"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "integer",
                  "minimum": 0
                },
                "stage": {
                  "const": "P3"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "B"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "$ref": "#/$defs/action"
                },
                "stage": {
                  "const": "B"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "M"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "minItems": 2,
                  "maxItems": 6
                },
                "stage": {
                  "const": "M"
                }
              }
            }
          }
        ]
      },
      "minItems": 31,
      "maxItems": 31
