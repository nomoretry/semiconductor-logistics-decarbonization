    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "#/$defs/nodeId"
          },
          "to": {
            "$ref": "#/$defs/nodeId"
          },
          "layer": {
            "enum": [
              "task",
              "object"
            ]
          }
