          },
          "question": {
            "$ref": "#/$defs/localized"
          },
          "answer": {}
        },
        "required": [
          "id",
          "stage",
          "question",
          "answer"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P1.stock.0",
                    "P1.stock.1",
                    "P1.stock.2"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "integer",
                  "minimum": 0
                },
                "stage": {
                  "const": "P1"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P1.backlog.0",
                    "P1.backlog.1",
                    "P1.backlog.2"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "integer",
                  "minimum": 0
                },
                "stage": {
                  "const": "P1"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P1.pipeline.0",
                    "P1.pipeline.1",
                    "P1.pipeline.2"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 6
                },
                "stage": {
                  "const": "P1"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P1.remaining"
