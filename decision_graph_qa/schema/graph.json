                  "minItems": 1,
                  "maxItems": 2
                },
                "stage": {
                  "const": "P1"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P2.sum.0",
                    "P2.sum.1",
                    "P2.sum.2"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "number"
                },
                "stage": {
                  "const": "P2"
                }
              }
            }
