              "properties": {
                "answer": {
                  "type": "integer",
                  "minimum": 0
                },
                "stage": {
                  "const": "P1"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P1.allowance"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "number"
                },
                "stage": {
                  "const": "P1"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "P1.routes"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "array",
                  "items": {
                    "enum": [
                      0,
                      1
                    ]
