    "objective": {
      "type": "number"
    },
    "ties": {
      "type": "object",
      "properties": {
        "new_objective": {
          "type": "number"
        },
        "opposite_flags": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "load_ranges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2,
          "maxItems": 2
        },
        "emission_range": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "other_action": {
          "type": "boolean"
        }
      },
      "required": [
        "new_objective",
        "opposite_flags",
        "load_ranges",
        "emission_range",
        "other_action"
      ],
      "additionalProperties": false
    },
    "hindsight": {
      "type": "object",
      "properties": {
        "prediction": {
          "type": "object",
          "properties": {
            "P2.sum.0": {
              "type": "number"
            },
            "P2.sum.1": {
              "type": "number"
            },
            "P2.sum.2": {
              "type": "number"
            },
            "P2.first.0": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "P2.first.1": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "P2.first.2": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "P2.peak.0": {
              "type": "number"
            },
            "P2.peak.1": {
              "type": "number"
            },
            "P2.peak.2": {
              "type": "number"
            },
            "P2.capacity": {
              "type": "boolean"
            },
            "P2.carbon": {
              "type": "boolean"
            }
          },
          "required": [
            "P2.sum.0",
            "P2.sum.1",
            "P2.sum.2",
            "P2.first.0",
            "P2.first.1",
            "P2.first.2",
            "P2.peak.0",
            "P2.peak.1",
            "P2.peak.2",
            "P2.capacity",
            "P2.carbon"
          ],
          "additionalProperties": false
        },
        "first_action_with_known_demand": {
          "$ref": "#/$defs/action"
        }
      },
      "required": [
        "prediction",
        "first_action_with_known_demand"
      ],
      "additionalProperties": false
    }
