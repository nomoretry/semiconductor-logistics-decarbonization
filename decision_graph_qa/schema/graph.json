  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "test"
      ]
    },
    "profile": {
      "enum": [
        "stable",
        "volatile",
        "upshift",
        "downshift"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "policy": {
      "enum": [
        "mpc_scenarios",
        "base_stock"
      ]
    },
    "observation": {
      "$ref": "#/$defs/state"
    },
    "state_text": {
      "$ref": "#/$defs/localized"
    },
